# Autonomous AI Company — Environment Variables
# Copy to .env — never commit .env

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/autonomous_company
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=autonomous_company

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ─── AI Providers ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...        # fallback provider only

# ─── Embedding ────────────────────────────────────────────
EMBEDDING_PROVIDER=anthropic  # anthropic | openai
EMBEDDING_MODEL=text-embedding-3-small

# ─── External APIs (Research Agent) ───────────────────────
BRAVE_SEARCH_API_KEY=...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
GITHUB_TOKEN=...

# ─── Deployment Targets ───────────────────────────────────
RAILWAY_TOKEN=...
VERCEL_TOKEN=...

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Service Ports ────────────────────────────────────────
API_GATEWAY_PORT=8000
MEMORY_SERVICE_PORT=8001
ORCHESTRATOR_PORT=8002
WORKFLOW_ENGINE_PORT=8003

# ─── Cost Guard ───────────────────────────────────────────
DAILY_COST_LIMIT_USD=5.00
ALERT_EMAIL=rajeshguntupalli59@gmail.com

# ─── Environment ──────────────────────────────────────────
ENV=development    # development | production
LOG_LEVEL=INFO
